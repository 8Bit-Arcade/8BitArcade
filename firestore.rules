rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - read public, write own (limited fields)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['isBanned', 'flags', 'totalScore', 'totalGamesPlayed']);
      allow delete: if false;
    }

    // Games collection - read only
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Sessions collection - read own only, write via Functions
    match /sessions/{sessionId} {
      allow read: if isAuthenticated()
                  && resource.data.player == request.auth.uid;
      allow write: if false;
    }

    // Scores collection - read public, write via Functions
    match /scores/{odedId} {
      allow read: if true;
      allow write: if false;
    }

    // Leaderboards collection - read public, write via Functions
    match /leaderboards/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Global leaderboard - read public
    match /globalLeaderboard/{period} {
      allow read: if true;
      allow write: if false;
    }

    // Tournaments collection - read public, write via Functions
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false;

      match /entries/{odedId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ─── Bracket Tournaments ────────────────────────────────────────────
    match /bracketTournaments/{tournamentId} {
      allow read: if true;
      allow write: if false; // Admin via Cloud Functions only

      match /participants/{address} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ─── PvP Matches ────────────────────────────────────────────────────
    match /pvpMatches/{matchId} {
      // Public read, but score data is sanitized by Cloud Functions
      allow read: if true;
      allow write: if false; // All writes via Cloud Functions
    }

    // ─── Global Arena Chat ──────────────────────────────────────────────
    match /pvpChat/{messageId} {
      // Public read for chat
      allow read: if true;
      allow write: if false; // Via sendChatMessage Cloud Function

      match /reactions/{reactionId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ─── Per-Match Chat (dynamic collection per matchId) ───────────────
    // Pattern: pvpMatchChat_{matchId}/{messageId}
    // Firestore wildcard handles any collection starting with pvpMatchChat_
    match /pvpMatchChat_{matchId}/{messageId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── User Profiles ──────────────────────────────────────────────────
    match /userProfiles/{address} {
      allow read: if true; // Public profiles
      allow write: if false; // Via updateUserProfile Cloud Function
    }

    // ─── Chat Rate Limits (internal) ────────────────────────────────────
    match /chatRateLimits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Config collection - read public
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // System collection - read public
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Rewards collection - read own only
    match /rewards/{odedId} {
      allow read: if isOwner(odedId);
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
